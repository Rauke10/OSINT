# ============================================================================
# GLOBEYE — example environment file.
# Copy to `.env` and fill in. NEVER commit your real `.env`.
# All keys are OPTIONAL: sources that need a key are skipped if it is absent.
# ============================================================================

# --- App ---
GLOBEYE_USER_AGENT="GlobeyeOSINT/0.1 (+https://github.com/rauke10/osint)"
GLOBEYE_CACHE_TTL_SECONDS=86400
GLOBEYE_CACHE_DIR=".cache"
GLOBEYE_HTTP_TIMEOUT_SECONDS=20
GLOBEYE_LOG_LEVEL="INFO"
# JSON logs are recommended for pipelines; "console" for local use.
GLOBEYE_LOG_FORMAT="console"

# --- Outbound proxy (route every request through Tor / a SOCKS5 proxy) ---
# Example for Tor: socks5://127.0.0.1:9050
GLOBEYE_PROXY_URL=""

# --- Self-hosted API auth (used by the FastAPI server only) ---
# If empty, the API refuses to start in non-debug mode.
GLOBEYE_API_KEY=""

# --- Enrichment (offline MaxMind GeoLite2 .mmdb files, optional) ---
GLOBEYE_GEOIP_CITY_DB=""
GLOBEYE_GEOIP_ASN_DB=""

# --- Persistence ---
GLOBEYE_DB_URL="sqlite:///./data/globeye.db"

# ============================================================================
# Third-party source credentials (all OPTIONAL — keyless sources still work)
# ============================================================================
GLOBEYE_SHODAN_API_KEY=""
GLOBEYE_CENSYS_API_ID=""
GLOBEYE_CENSYS_API_SECRET=""
GLOBEYE_SECURITYTRAILS_API_KEY=""
GLOBEYE_OTX_API_KEY=""
GLOBEYE_HIBP_API_KEY=""
GLOBEYE_HUNTER_API_KEY=""
GLOBEYE_DEHASHED_EMAIL=""
GLOBEYE_DEHASHED_API_KEY=""
GLOBEYE_GITHUB_TOKEN=""
GLOBEYE_GOOGLE_CSE_KEY=""
GLOBEYE_GOOGLE_CSE_CX=""
