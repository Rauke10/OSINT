# ============================================================================
# GLOBEYE — example environment file.
# Copy to `.env` and fill in. NEVER commit your real `.env`.
# All keys are OPTIONAL: sources that need a key are skipped if it is absent.
# ============================================================================

# --- App ---
GLOBEYE_USER_AGENT="GlobeyeOSINT/0.1 (+https://github.com/rauke10/osint)"
GLOBEYE_CACHE_TTL_SECONDS=86400
# Leave GLOBEYE_CACHE_DIR unset to use the default (.cache locally,
# /data/cache in the container). A relative path breaks the read-only
# container, so only set it to an absolute, writable path.
# GLOBEYE_CACHE_DIR=".cache"
GLOBEYE_HTTP_TIMEOUT_SECONDS=20
# Hard ceiling for a whole scan (including pivots), in seconds.
GLOBEYE_SCAN_TIMEOUT_SECONDS=300
GLOBEYE_LOG_LEVEL="INFO"
# JSON logs are recommended for pipelines; "console" for local use.
GLOBEYE_LOG_FORMAT="console"

# --- Outbound proxy (route every request through Tor / a SOCKS5 proxy) ---
# Example for Tor: socks5://127.0.0.1:9050
GLOBEYE_PROXY_URL=""

# --- Self-hosted API auth (FastAPI server only; NOT a third-party key) ---
# A secret YOU invent to protect your own API. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it the API rejects scan requests with 503. For local use only you
# can instead set GLOBEYE_API_DEBUG=true to disable authentication entirely.
GLOBEYE_API_KEY=""
GLOBEYE_API_DEBUG=false

# --- Enrichment (offline MaxMind GeoLite2 .mmdb files, optional) ---
GLOBEYE_GEOIP_CITY_DB=""
GLOBEYE_GEOIP_ASN_DB=""

# --- Persistence ---
# Leave unset to use the default (./data/globeye.db locally, /data in the
# container). Only override with an absolute, writable path.
# GLOBEYE_DB_URL="sqlite:///./data/globeye.db"

# ============================================================================
# Third-party source credentials (all OPTIONAL — keyless sources still work)
# ============================================================================
GLOBEYE_SHODAN_API_KEY=""
GLOBEYE_CENSYS_API_ID=""
GLOBEYE_CENSYS_API_SECRET=""
GLOBEYE_SECURITYTRAILS_API_KEY=""
GLOBEYE_OTX_API_KEY=""
GLOBEYE_HIBP_API_KEY=""
GLOBEYE_HUNTER_API_KEY=""
GLOBEYE_DEHASHED_EMAIL=""
GLOBEYE_DEHASHED_API_KEY=""
GLOBEYE_GITHUB_TOKEN=""
GLOBEYE_GOOGLE_CSE_KEY=""
GLOBEYE_GOOGLE_CSE_CX=""
# Chaos & GreyNoise need a (free) key; the rest are Optional — without them
# the source still runs, the key just raises the rate limit.
GLOBEYE_URLSCAN_API_KEY=""
GLOBEYE_CHAOS_API_KEY=""
GLOBEYE_GREYNOISE_API_KEY=""
GLOBEYE_EMAILREP_API_KEY=""
GLOBEYE_ABUSECH_AUTH_KEY=""
